{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["scenes"],
  "properties": {
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sceneId", "semanticJob", "selectedConcept"],
        "properties": {
          "sceneId": {"type": "string"},
          "semanticJob": {"type": "string"},
          "creativeUncertainty": {"enum": ["low", "medium", "high"]},
          "candidates": {
            "type": "array",
            "maxItems": 4,
            "items": {"$ref": "#/$defs/concept"}
          },
          "selectedConcept": {"$ref": "#/$defs/concept"},
          "selectionRationale": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "concept": {
      "type": "object",
      "required": ["visualThesis", "mechanism", "anchor", "action", "consequence", "signatureMoment", "assetRoles"],
      "properties": {
        "visualThesis": {"type": "string"},
        "mechanism": {"type": "string"},
        "anchor": {"type": "string"},
        "action": {"type": "string"},
        "consequence": {"type": "string"},
        "launchpad": {"type": "string"},
        "signatureMoment": {"type": "string"},
        "representationType": {"enum": ["literal", "evidence", "reconstruction", "metaphor", "abstract"]},
        "assetRoles": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string"}},
        "continuityHandoff": {"type": "string"},
        "productionFeasibility": {"enum": ["high", "medium", "low"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
