{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Post-Narration Frame Scene Specification",
  "type": "object",
  "required": [
    "fps",
    "alignmentSource",
    "scenes"
  ],
  "properties": {
    "fps": {
      "type": "number",
      "minimum": 1
    },
    "alignmentSource": {
      "type": "string",
      "minLength": 1
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sceneId",
          "sceneStartSec",
          "sceneDurationSec",
          "microbeats"
        ],
        "properties": {
          "sceneId": {
            "type": "string"
          },
          "sceneStartSec": {
            "type": "number",
            "minimum": 0
          },
          "sceneDurationSec": {
            "type": "number",
            "minimum": 0.1
          },
          "microbeats": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "offsetSec",
                "event"
              ],
              "properties": {
                "offsetSec": {
                  "type": "number",
                  "minimum": 0
                },
                "event": {
                  "type": "string"
                },
                "narrationAnchor": {
                  "type": "string"
                },
                "motionRole": {
                  "enum": [
                    "primary",
                    "support",
                    "camera",
                    "hold",
                    "transition",
                    "audio"
                  ]
                },
                "focalTarget": {
                  "type": "string"
                },
                "attentionZone": {
                  "enum": [
                    "top-left",
                    "top-center",
                    "top-right",
                    "mid-left",
                    "center",
                    "mid-right",
                    "bottom-left",
                    "bottom-center",
                    "bottom-right"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "camera": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string"
              },
              "parameters": {
                "type": "object"
              }
            },
            "additionalProperties": false
          },
          "motionParameters": {
            "type": "object"
          },
          "sfxEvents": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "offsetSec",
                "visualEvent",
                "sfx",
                "syncPoint",
                "priority"
              ],
              "properties": {
                "offsetSec": {
                  "type": "number",
                  "minimum": 0
                },
                "visualEvent": {
                  "type": "string"
                },
                "sfx": {
                  "type": "string"
                },
                "syncPoint": {
                  "enum": [
                    "attack",
                    "movement",
                    "settle",
                    "release",
                    "transition"
                  ]
                },
                "priority": {
                  "enum": [
                    "support",
                    "accent",
                    "major"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "implementationNotes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tunableParameterManifestRef": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
