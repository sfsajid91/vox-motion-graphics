{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compact Motion Graphics Scene Plan",
  "type": "object",
  "required": [
    "project",
    "styleProfile",
    "scenes"
  ],
  "properties": {
    "project": {
      "type": "object",
      "required": [
        "aspectRatio",
        "fps"
      ],
      "properties": {
        "aspectRatio": {
          "type": "string"
        },
        "fps": {
          "type": "number",
          "minimum": 1
        },
        "targetDurationSec": {
          "type": "number",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "styleProfile": {
      "type": "object",
      "required": [
        "name",
        "palette",
        "motionCadence"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "palette": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "typography": {
          "type": "object"
        },
        "imageTreatment": {
          "type": "string"
        },
        "texture": {
          "type": "string"
        },
        "motionCadence": {
          "type": "string"
        },
        "cameraPersonality": {
          "type": "string"
        },
        "captionMode": {
          "enum": [
            "none",
            "sparse",
            "accessibility/full"
          ]
        },
        "sfxPalette": {
          "type": "string"
        },
        "continuityTokens": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "beatIds",
          "purpose",
          "visualThesis",
          "representationType",
          "primaryAction",
          "estimatedDurationSec",
          "assetRoles",
          "qaStatus",
          "visualMechanism",
          "launchpad",
          "attentionContinuity",
          "microStructure",
          "constructionFamily"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "beatIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "purpose": {
            "type": "string"
          },
          "viewerStateIn": {
            "type": "string"
          },
          "viewerStateOut": {
            "type": "string"
          },
          "emotionalBeat": {
            "type": "string"
          },
          "visualThesis": {
            "type": "string"
          },
          "representationType": {
            "enum": [
              "literal",
              "evidence",
              "reconstruction",
              "metaphor",
              "abstract"
            ]
          },
          "claimIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "environment": {
            "type": "string"
          },
          "composition": {
            "type": "object",
            "properties": {
              "background": {
                "type": "string"
              },
              "midground": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "foreground": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "focalPoint": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "primaryAction": {
            "type": "string"
          },
          "signatureMoment": {
            "type": "string"
          },
          "roughMicroEvents": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 7
          },
          "cameraIdea": {
            "type": "string"
          },
          "continuityAnchor": {
            "type": "string"
          },
          "transitionIdea": {
            "type": "string"
          },
          "estimatedDurationSec": {
            "type": "number",
            "minimum": 0.5
          },
          "assetRoles": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "role",
                "preferredSourceStrategy"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "preferredSourceStrategy": {
                  "enum": [
                    "programmatic",
                    "owned",
                    "licensed",
                    "public_domain",
                    "library",
                    "generated",
                    "needs_sourcing"
                  ]
                },
                "representationType": {
                  "enum": [
                    "literal",
                    "evidence",
                    "reconstruction",
                    "metaphor",
                    "abstract"
                  ]
                },
                "claimIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "representationType": {
                        "const": "evidence"
                      }
                    },
                    "required": [
                      "representationType"
                    ]
                  },
                  "then": {
                    "required": [
                      "claimIds"
                    ],
                    "properties": {
                      "claimIds": {
                        "minItems": 1
                      }
                    }
                  }
                }
              ]
            },
            "maxItems": 8
          },
          "artDirectedText": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "text",
                "purpose"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "purpose": {
                  "enum": [
                    "label",
                    "number",
                    "quote",
                    "emphasis",
                    "evidence"
                  ]
                },
                "claimIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "purpose": {
                        "const": "evidence"
                      }
                    },
                    "required": [
                      "purpose"
                    ]
                  },
                  "then": {
                    "required": [
                      "claimIds"
                    ],
                    "properties": {
                      "claimIds": {
                        "minItems": 1
                      }
                    }
                  }
                }
              ]
            },
            "maxItems": 5
          },
          "complexity": {
            "type": "object",
            "properties": {
              "meaningfulAssetCount": {
                "type": "integer",
                "minimum": 0
              },
              "signatureDeviceCount": {
                "type": "integer",
                "minimum": 0
              },
              "majorConcurrentMotionCount": {
                "type": "integer",
                "minimum": 0
              },
              "ambientSystemCount": {
                "type": "integer",
                "minimum": 0
              },
              "transitionGimmickCount": {
                "type": "integer",
                "minimum": 0
              },
              "complexityJustification": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "qaStatus": {
            "const": "pending_review"
          },
          "planningRisks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "visualMechanism": {
            "type": "string"
          },
          "anchorState": {
            "type": "string"
          },
          "consequenceState": {
            "type": "string"
          },
          "launchpad": {
            "type": "string"
          },
          "constructionFamily": {
            "type": "string",
            "minLength": 1
          },
          "representationTypes": {
            "type": "array",
            "items": {
              "enum": [
                "literal",
                "evidence",
                "reconstruction",
                "metaphor",
                "abstract"
              ]
            },
            "uniqueItems": true
          },
          "attentionContinuity": {
            "type": "object",
            "properties": {
              "entryZone": {
                "enum": [
                  "top-left",
                  "top-center",
                  "top-right",
                  "mid-left",
                  "center",
                  "mid-right",
                  "bottom-left",
                  "bottom-center",
                  "bottom-right"
                ]
              },
              "exitZone": {
                "enum": [
                  "top-left",
                  "top-center",
                  "top-right",
                  "mid-left",
                  "center",
                  "mid-right",
                  "bottom-left",
                  "bottom-center",
                  "bottom-right"
                ]
              },
              "dominantDirection": {
                "enum": [
                  "left-to-right",
                  "right-to-left",
                  "up",
                  "down",
                  "inward",
                  "outward",
                  "clockwise",
                  "counterclockwise",
                  "static",
                  "mixed"
                ]
              },
              "scaleClassIn": {
                "enum": [
                  "macro",
                  "medium",
                  "micro"
                ]
              },
              "scaleClassOut": {
                "enum": [
                  "macro",
                  "medium",
                  "micro"
                ]
              },
              "handoffObject": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "handoffReason": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "microStructure": {
            "type": "object",
            "properties": {
              "anchor": {
                "type": "string"
              },
              "action": {
                "type": "string"
              },
              "consequence": {
                "type": "string"
              },
              "launchpad": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "conflictModel": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "actor": {
                "type": "string"
              },
              "counterForce": {
                "type": "string"
              },
              "stakes": {
                "type": "string"
              }
            },
            "required": [
              "actor",
              "counterForce",
              "stakes"
            ],
            "additionalProperties": false
          },
          "referenceTechniqueRefs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "representationType": {
                  "const": "evidence"
                }
              },
              "required": [
                "representationType"
              ]
            },
            "then": {
              "required": [
                "claimIds"
              ],
              "properties": {
                "claimIds": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
