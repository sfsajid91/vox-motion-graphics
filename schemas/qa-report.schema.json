{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External Motion Graphics QA Report",
  "type": "object",
  "required": ["critic", "renderId", "overallStatus", "dimensions", "sceneFindings"],
  "properties": {
    "critic": {"type": "string", "minLength": 1},
    "renderId": {"type": "string", "minLength": 1},
    "overallStatus": {"enum": ["fail", "revise", "publish_candidate"]},
    "dimensions": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 5
      }
    },
    "sceneFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sceneId", "status", "findings"],
        "properties": {
          "sceneId": {"type": "string"},
          "status": {"enum": ["pass", "revise", "fail"]},
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["dimension", "problem", "repair"],
              "properties": {
                "dimension": {"type": "string"},
                "problem": {"type": "string"},
                "repair": {"type": "string"},
                "severity": {"enum": ["low", "medium", "high"]}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
