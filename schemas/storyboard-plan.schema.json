{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v0.8 HTML Storyboard Plan",
  "type": "object",
  "required": [
    "projectId",
    "preview",
    "status",
    "scenes"
  ],
  "properties": {
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "preview": {
      "type": "object",
      "required": [
        "path",
        "mode"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "lightweight",
            "playable"
          ]
        }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "draft",
        "in_review",
        "ready_for_approval",
        "frozen"
      ]
    },
    "freezeEvidence": {
      "type": "object",
      "required": [
        "reviewer",
        "reviewRef",
        "independent"
      ],
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reviewRef": {
          "type": "string",
          "minLength": 1
        },
        "independent": {
          "const": true
        },
        "frozenAt": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "beatIds",
          "visualThesis",
          "focalPoint",
          "dominantRelationship",
          "constructionFamily",
          "assetIds",
          "states",
          "transitionIntent"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "beatIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "visualThesis": {
            "type": "string",
            "minLength": 1
          },
          "focalPoint": {
            "type": "string",
            "minLength": 1
          },
          "dominantRelationship": {
            "type": "string",
            "minLength": 1
          },
          "constructionFamily": {
            "type": "string",
            "minLength": 1
          },
          "assetIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "states": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "purpose",
                "focalElement"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1
                },
                "focalElement": {
                  "type": "string",
                  "minLength": 1
                },
                "meaningfulChange": {
                  "type": "string",
                  "minLength": 1
                },
                "intentionalHoldReason": {
                  "type": "string",
                  "minLength": 1
                },
                "narrationAnchor": {
                  "type": "string"
                },
                "assetIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                }
              },
              "additionalProperties": false,
              "oneOf": [
                {
                  "required": [
                    "meaningfulChange"
                  ]
                },
                {
                  "required": [
                    "intentionalHoldReason"
                  ]
                }
              ]
            }
          },
          "motionIntent": {
            "type": "string"
          },
          "transitionIntent": {
            "type": "string",
            "minLength": 1
          },
          "representationRisk": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "reviewEvidence": {
      "type": "object",
      "required": [
        "reviewer",
        "reviewRef",
        "independent"
      ],
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reviewRef": {
          "type": "string",
          "minLength": 1
        },
        "independent": {
          "const": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "frozen"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "freezeEvidence"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready_for_approval"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "reviewEvidence"
        ]
      }
    }
  ]
}
