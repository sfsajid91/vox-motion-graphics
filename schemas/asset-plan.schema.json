{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "projectId",
    "assets"
  ],
  "properties": {
    "projectId": {
      "type": "string"
    },
    "styleProfileRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "usedByScenes",
          "representationType",
          "strategy",
          "requirements",
          "motionNeeds",
          "provenance",
          "approvalStatus"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "usedByScenes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "claimIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "representationType": {
            "enum": [
              "literal",
              "evidence",
              "reconstruction",
              "metaphor",
              "abstract"
            ]
          },
          "strategy": {
            "type": "object",
            "required": [
              "preferred",
              "fallback"
            ],
            "properties": {
              "preferred": {
                "enum": [
                  "reuse",
                  "programmatic",
                  "source",
                  "reconstruction",
                  "generate"
                ]
              },
              "fallback": {
                "enum": [
                  "none",
                  "reuse",
                  "programmatic",
                  "source",
                  "reconstruction",
                  "generate"
                ]
              }
            },
            "additionalProperties": false
          },
          "requirements": {
            "type": "object"
          },
          "motionNeeds": {
            "type": "object"
          },
          "candidatePolicy": {
            "type": "object"
          },
          "provenance": {
            "type": "object",
            "required": [
              "rightsStatus"
            ],
            "properties": {
              "rightsStatus": {
                "enum": [
                  "unresolved",
                  "needs_review",
                  "self_created",
                  "verified"
                ]
              },
              "sourceUri": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "license": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sourceProvider": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          },
          "approvalStatus": {
            "const": "pending_review"
          }
        },
        "additionalProperties": true,
        "allOf": [
          {
            "if": {
              "properties": {
                "representationType": {
                  "const": "literal"
                }
              },
              "required": [
                "representationType"
              ]
            },
            "then": {
              "properties": {
                "strategy": {
                  "properties": {
                    "preferred": {
                      "enum": [
                        "reuse",
                        "programmatic",
                        "source",
                        "reconstruction"
                      ]
                    },
                    "fallback": {
                      "enum": [
                        "none",
                        "reuse",
                        "programmatic",
                        "source",
                        "reconstruction"
                      ]
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "provenance": {
                  "properties": {
                    "rightsStatus": {
                      "const": "verified"
                    }
                  },
                  "required": [
                    "rightsStatus"
                  ]
                }
              },
              "required": [
                "provenance"
              ]
            },
            "then": {
              "properties": {
                "provenance": {
                  "required": [
                    "sourceUri",
                    "license",
                    "evidence"
                  ],
                  "properties": {
                    "sourceUri": {
                      "type": "string",
                      "minLength": 1
                    },
                    "license": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": true
}
