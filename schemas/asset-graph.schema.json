{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["nodes", "sceneUsage"],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assetId", "continuityRole", "semanticRoles"],
        "properties": {
          "assetId": {"type": "string"},
          "continuityRole": {"enum": ["master", "derived", "scene_only"]},
          "derivedFrom": {"type": ["string", "null"]},
          "semanticRoles": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "sceneUsage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sceneId", "assetIds"],
        "properties": {
          "sceneId": {"type": "string"},
          "assetIds": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
